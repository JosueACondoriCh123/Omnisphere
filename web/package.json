{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "db:serve": "node server/start.js",
    "test:db": "node --test server/*.test.js",
    "build": "vite build",
    "build:vercel": "vite build --mode vercel",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:vercel": "npm run build:vercel && playwright test --config playwright.vercel.config.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
