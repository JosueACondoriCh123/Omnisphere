# Public address used by capture nodes outside Docker.
PUBLIC_RTMP_HOST=localhost
PUBLIC_RTMP_PORT=1935
RTMP_BIND_ADDRESS=0.0.0.0
API_BIND_ADDRESS=0.0.0.0

# Internal service wiring (the Compose defaults are ready to use).
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTSP_BASE=rtsp://mediamtx:8554
INTERNAL_API_BASE=http://plumbing:8080
INTERNAL_TOKEN=change-me-before-production
REDIS_URL=redis://redis:6379/0

# Optional remote context and transcription services.
# CONTEXT_URL_TEMPLATE=http://context-service/api/stages/{stage_id}/context
# TRANSCRIBER_URL=http://transcriber:8090/v1/audio/segments

# Transcriber service (Compose service `transcriber`). Without a key it starts
# and answers /health, but every segment returns 503 and the room worker
# degrades, raising the transcriber_socket_down alarm.
# GEMINI_API_KEY=
# TRANSCRIPTION_MODEL=gemini-3.5-flash
# TRANSCRIBER_TIMEOUT_SECONDS=12
# TRANSCRIBER_MAX_SEGMENT_SECONDS=40

# VAD tuning for a live event hall.
VAD_THRESHOLD=0.55
VAD_MIN_SILENCE_MS=420
VAD_SPEECH_PAD_MS=140
MAX_SEGMENT_SECONDS=28
FFMPEG_RECONNECT_SECONDS=1.0
STREAM_GRACE_SECONDS=15

# Polling and health thresholds.
MEDIAMTX_POLL_SECONDS=1.0
CAPTURE_NODE_STALE_SECONDS=15
WORKER_STALE_SECONDS=12
